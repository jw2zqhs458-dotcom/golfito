# ─── Acceso al sitio del Club Newman ──────────────────────────────────────────
# (Cargá los valores reales en Vercel → Settings → Environment Variables,
#  NUNCA en el repo.)
NEWMAN_USER=tu-numero-de-matricula
NEWMAN_PASS=tu-clave
# Apellido del socio (para detectar reservas ya hechas y no duplicar).
NEWMAN_SURNAME=TU-APELLIDO

# ─── Preferencias de reserva ──────────────────────────────────────────────────
# Días a buscar (coma-separados): sabado, domingo, lunes, ...
NEWMAN_TARGET_DAYS=sabado,domingo
# Horario objetivo: se elige la línea libre más cercana a esta hora.
NEWMAN_TARGET_TIME=10:00
# Matrículas de los acompañantes que completan la línea (coma-separadas).
# Por defecto VACÍO: reserva sólo tu matrícula (evita mandar mails a terceros).
NEWMAN_PARTNERS=
# true = reserva automáticamente; false = sólo avisa por WhatsApp.
# Por seguridad arranca en false; ponelo en true cuando lo quieras activar.
NEWMAN_AUTO_BOOK=false

# ─── Protección del endpoint de cron ──────────────────────────────────────────
# Vercel envía "Authorization: Bearer <CRON_SECRET>" a /api/cron automáticamente.
CRON_SECRET=cambiame-por-un-secreto-largo

# ─── Twilio WhatsApp ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de envío de Twilio (sandbox: whatsapp:+14155238886).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Tu número de WhatsApp donde querés recibir los avisos.
TWILIO_WHATSAPP_TO=whatsapp:+549XXXXXXXXXX
